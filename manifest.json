{
  "manifest_version": 3,
  "name": "MediTrack BD — Medicine Inventory & Order Tracker",
  "short_name": "MediTrack",
  "version": "1.2.0",
  "description": "Track medicine inventory, get low-stock & expiry notifications, auto-refresh MedEx prices, one-click order generation — product data sourced from medex.com.bd.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://medex.com.bd/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open MediTrack",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
